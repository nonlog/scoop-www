{
    "version": "4.0.8.4",
    "description": "League of Legends voice assistant and language voice pack manager.",
    "homepage": "https://www.timeweii.com/sound.html",
    "license": "Unknown",
    "icon": "https://raw.githubusercontent.com/nonlog/scoop-www/master/icons/shilan-sound.ico",
    "architecture": {
        "64bit": {
            "url": "https://cdn.sc1.timeweii.com/d/PanAlist189PCPan3/SoundInstaller/%E8%AF%97%E8%93%9D%E8%AF%AD%E9%9F%B3%E5%8A%A9%E6%89%8Bv4.0.8.4_Release.zip",
            "hash": "93c680aefb87861d479e40da8bfc86f50047a72b326ae837fc4451b896ae2942"
        }
    },
    "bin": "SoundInstaller.exe",
    "shortcuts": [
        [
            "SoundInstaller.exe",
            "Shilan Sound"
        ]
    ],
    "pre_install": "& \"$bucketsdir\\$bucket\\scripts\\shilan-sound\\extract.ps1\" -Dir $dir",
    "checkver": {
        "url": "https://www.timeweii.com/sound.html",
        "script": [
            "$match = [regex]::Match($page, 'href=\"(?<url>https://cdn\\.sc1\\.timeweii\\.com/[^\"]*SoundInstaller/[^\"]*v(?<version>[\\d.]+)_Release\\.zip)\"')",
            "if ($match.Success) { Write-Output ($match.Groups['version'].Value + ' ' + $match.Groups['url'].Value) }"
        ],
        "regex": "^(?<version>[\\d.]+) (?<url>https://\\S+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchUrl"
            }
        }
    },
    "notes": [
        "The outer upstream installer is unpacked by the Scoop pre-install script; the embedded SoundInstaller.exe is the portable program managed by Scoop.",
        "The program requires .NET Framework 4.6.2 or newer and may need administrator rights to modify League of Legends files.",
        "Scoop uses the official direct CDN URL shown on the upstream download page; the Lanzou share page is only used by the website as a redirect.",
        "The program's own voice-resource downloads are separate from Scoop updates."
    ]
}

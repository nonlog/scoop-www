            "hash": "20023c035d7aa28680345c0049781b03a0c6a430cfdf5ebf8b3bd3d04ebf4c62"
        },
        "arm64": {
            "url": "https://github.com/Kuddev/pebrel/releases/download/v2.2.0/Pebrel-v2.2.0-windows-arm64.zip",
            "hash": "780fa61cd4260b6e8a1be9ac4e6e030bcc5df90ebcb4dc9f429551c0255c5a8b"
        }
    },
    "pre_install": "Remove-Item \"$dir\\docs\", \"$dir\\skills\" -Force -Recurse -ErrorAction SilentlyContinue",
    "bin": [
        [
            "pebrel.exe",
            "pebrel"
        ],
        [
            "pebrel.exe",
            "nebula"
        ]
    ],
    "shortcuts": [
        [
            "pebrel.exe",
            "Pebrel"
        ]
    ],
    "checkver": {
        "url": "https://github.com/Kuddev/pebrel/releases/latest",
        "regex": "/releases/tag/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Kuddev/pebrel/releases/download/v$version/Pebrel-v$version-windows-x64.zip",
                "hash": {
                    "url": "https://github.com/Kuddev/pebrel/releases/download/v$version/SHA256SUMS",
                    "regex": "$sha256\\s+Pebrel-v$version-windows-x64\\.zip"
                }
            },
            "arm64": {
                "url": "https://github.com/Kuddev/pebrel/releases/download/v$version/Pebrel-v$version-windows-arm64.zip",
                "hash": {
                    "url": "https://github.com/Kuddev/pebrel/releases/download/v$version/SHA256SUMS",
                    "regex": "$sha256\\s+Pebrel-v$version-windows-arm64\\.zip"
                }
            }
        }
    },
    "notes": "Nebula Terminal was renamed to Pebrel. Existing settings are migrated by the application."
}

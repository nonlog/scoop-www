{
    "version": "2.4.0",
    "description": "Terminal music player inspired by Winamp, tracking stable and pre-release builds.",
    "homepage": "https://github.com/bjarneo/cliamp",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/bjarneo/cliamp/releases/download/v2.4.0/cliamp-windows-amd64.zip",
            "hash": "2f98eb4f968d603dadf0d68ef50a28104f2b7d7a0d01a55a49547bf9ba91dbcb"
        }
    },
    "bin": "cliamp-windows-amd64\\cliamp.exe",
    "checkver": {
        "github": "https://api.github.com/repos/bjarneo/cliamp/releases",
        "script": [
            "# GitHub API mode replaces jsonpath with $.tag_name unless a script is present",
            "Write-Output $page"
        ],
        "jsonpath": "$[?(@.draft == false)].tag_name",
        "regex": "v(?<version>[\\w.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bjarneo/cliamp/releases/download/v$version/cliamp-windows-amd64.zip"
            }
        },
        "hash": {
            "url": "https://github.com/bjarneo/cliamp/releases/download/v$version/checksums.txt",
            "regex": "$sha256\\s+cliamp-windows-amd64\\.zip"
        }
    }
}

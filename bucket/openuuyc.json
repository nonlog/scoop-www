{
    "version": "0.7.0",
    "description": "A third-party Windows client for UU Remote, written in Rust.",
    "homepage": "https://github.com/djkcyl/farwing",
    "license": "Unknown",
    "icon": "https://raw.githubusercontent.com/nonlog/scoop-www/master/icons/openuuyc.ico",
    "architecture": {
        "64bit": {
            "url": "https://github.com/djkcyl/farwing/releases/download/v0.7.0/OpenUUYC-v0.7.0-windows-x86_64.exe#/OpenUUYC.exe",
            "hash": "d5ada7d9b308fcfae41ca70e8dd4218a1caea98feda75c31fa2beb0cff556572"
        }
    },
    "bin": "OpenUUYC.exe",
    "shortcuts": [
        [
            "OpenUUYC.exe",
            "OpenUUYC"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/djkcyl/farwing/releases/latest",
        "script": [
            "$release = $page | ConvertFrom-Json",
            "$asset = $release.assets | Where-Object { $_.name -match '^(OpenUUYC|Farwing).*windows-x86_64\\.exe$' } | Select-Object -First 1",
            "if (-not $asset) { throw 'Windows x64 release asset not found.' }",
            "Write-Output ($release.tag_name.TrimStart('v') + ' ' + $asset.browser_download_url)"
        ],
        "regex": "^(?<version>[\\d.]+) (?<url>https://\\S+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchUrl#/OpenUUYC.exe"
            }
        }
    },
    "notes": [
        "The Scoop package is the portable client. Installing the resident service from inside the app copies it to %ProgramFiles%\\OpenUUYC.",
        "Releases from 1.0.0-rc on can update that installed copy from a newer package with: OpenUUYC.exe update --silent --no-elevate (run from an elevated shell)."
    ]
}

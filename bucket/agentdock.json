{
    "version": "0.9.2",
    "description": "Windows AgentDock with Scoop-managed binaries and a persistent Scoop runtime directory.",
    "homepage": "https://github.com/uvwt/agentdock",
    "icon": "https://raw.githubusercontent.com/nonlog/scoop-www/master/icons/agentdock.ico",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/uvwt/agentdock/releases/download/v0.9.2/agentdock_windows_amd64.zip",
            "hash": "55c647e6cfe23e32ccd0bb32b204ca554d31ff74a003ea1d68e0a85e16726f06"
        }
    },
    "shortcuts": [
        [
            "agentdock-tray.exe",
            "AgentDock Tray",
            "",
            "agentdock.ico"
        ]
    ],
    "pre_install": "& \"$bucketsdir\\$bucket\\scripts\\agentdock\\sync.ps1\" -Phase pre -PackageDir \"$dir\" -RuntimeRoot 'D:\\Programs\\Scoop\\persist\\agentdock'",
    "post_install": "& \"$bucketsdir\\$bucket\\scripts\\agentdock\\sync.ps1\" -Phase post -PackageDir \"$dir\" -RuntimeRoot 'D:\\Programs\\Scoop\\persist\\agentdock'",
    "notes": [
        "AgentDock 程序由 Scoop 管理，配置和 DPAPI 认证文件保留在 D:\\Programs\\Scoop\\persist\\agentdock。",
        "Cloudflared 由 Winget 管理，不由此 manifest 更新。",
        "更新命令：scoop update agentdock"
    ],
    "checkver": {
        "url": "https://github.com/uvwt/agentdock/releases/latest",
        "regex": "/releases/tag/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/uvwt/agentdock/releases/download/v$version/agentdock_windows_amd64.zip"
            }
        }
    }
}

{
    "version": "1.19.3",
    "description": "Cross-platform Mihomo (Clash Meta) network debugging and rule-based traffic splitting client.",
    "homepage": "https://github.com/appshubcc/Bettbox",
    "icon": "https://raw.githubusercontent.com/nonlog/scoop-www/master/icons/bettbox.ico",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/appshubcc/Bettbox/releases/download/v1.19.3/Bettbox-1.19.3-windows-amd64-setup.exe",
            "hash": "2bb768769f0549494eb411ba15fd56d68fff15b99b35c84eac3748f88cde87ca"
        },
        "arm64": {
            "url": "https://github.com/appshubcc/Bettbox/releases/download/v1.19.3/Bettbox-1.19.3-windows-arm64-setup.exe",
            "hash": "46518ff2209136933b6c6b1a453db1aaba51ea3807f6f9c499d660347747c0c3"
        }
    },
    "innosetup": true,
    "bin": "Bettbox.exe",
    "shortcuts": [
        [
            "Bettbox.exe",
            "Bettbox"
        ]
    ],
    "post_install": [
        "$app_data = Join-Path $env:APPDATA 'com.appshub\\Bettbox'",
        "$persist_data = Join-Path $persist_dir 'data'",
        "New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
        "New-Item -ItemType Directory -Path (Split-Path -Parent $app_data) -Force | Out-Null",
        "if (Test-Path -LiteralPath $app_data) {",
        "    $existing = Get-Item -LiteralPath $app_data -Force",
        "    if ($existing.LinkType) {",
        "        $target = $existing.Target | Select-Object -First 1",
        "        if (-not $target -or ([IO.Path]::GetFullPath($target).TrimEnd('\\') -ne [IO.Path]::GetFullPath($persist_data).TrimEnd('\\'))) { Write-Warning 'Existing Bettbox data link was not changed.' }",
        "    } elseif (Test-Path -LiteralPath $persist_data) {",
        "        Copy-Item -Path (Join-Path $app_data '*') -Destination $persist_data -Recurse -Force",
        "        Remove-Item -LiteralPath $app_data -Recurse -Force",
        "    } else {",
        "        Move-Item -LiteralPath $app_data -Destination $persist_data",
        "    }",
        "}",
        "if (!(Test-Path -LiteralPath $persist_data)) { New-Item -ItemType Directory -Path $persist_data -Force | Out-Null }",
        "if (!(Test-Path -LiteralPath $app_data)) { New-DirectoryJunction $app_data $persist_data | Out-Null }"
    ],
    "post_uninstall": [
        "$app_data = Join-Path $env:APPDATA 'com.appshub\\Bettbox'",
        "$persist_data = Join-Path $persist_dir 'data'",
        "if (Test-Path -LiteralPath $app_data) {",
        "    $existing = Get-Item -LiteralPath $app_data -Force",
        "    $target = $existing.Target | Select-Object -First 1",
        "    if ($existing.LinkType -eq 'Junction' -and $target -and ([IO.Path]::GetFullPath($target).TrimEnd('\\') -eq [IO.Path]::GetFullPath($persist_data).TrimEnd('\\'))) { Remove-Item -LiteralPath $app_data -Force }",
        "}"
    ],
    "checkver": {
        "url": "https://github.com/appshubcc/Bettbox/releases/latest",
        "regex": "/releases/tag/(?:v|V)?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/appshubcc/Bettbox/releases/download/v$version/Bettbox-$version-windows-amd64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/appshubcc/Bettbox/releases/download/v$version/Bettbox-$version-windows-arm64-setup.exe"
            }
        }
    },
    "notes": [
        "Bettbox configuration is redirected from %APPDATA%\\com.appshub\\Bettbox to the Scoop persist directory.",
        "Quit Bettbox before updating. The three-step update commands are recorded in the persistent data directory."
    ]
}

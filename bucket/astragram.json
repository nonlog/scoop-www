{
    "version": "7.3.1.9",
    "description": "A customizable Telegram Desktop fork based on AyuGram.",
    "homepage": "https://github.com/Kindness-Kismet/AstraGram-Desktop",
    "license": "GPL-3.0-or-later",
    "icon": "https://raw.githubusercontent.com/nonlog/scoop-www/master/icons/astragram.ico",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Kindness-Kismet/AstraGram-Desktop/releases/download/v7.3.1.9/AstraGram-v7.3.1.9-win-x64.zip",
            "hash": "4d8afce1f7eb43871281a53b828a30b936926f72c0e2c0d4e43a1944cbfa0d7a"
        },
        "arm64": {
            "url": "https://github.com/Kindness-Kismet/AstraGram-Desktop/releases/download/v7.3.1.9/AstraGram-v7.3.1.9-win-arm64.zip",
            "hash": "846779d65053357b260dc89b91591697cea9da2b6e81140f1cf16bc26a67f369"
        }
    },
    "bin": [
        [
            "AstraGram.exe",
            "astragram"
        ]
    ],
    "shortcuts": [
        [
            "AstraGram.exe",
            "AstraGram"
        ]
    ],
    "persist": "TelegramForcePortable",
    "post_install": [
        "$portable = Join-Path $persist_dir 'TelegramForcePortable'",
        "$external = Join-Path $portable 'externalupdater.d'",
        "New-Item -ItemType Directory -Path $external -Force | Out-Null",
        "$exe = Join-Path (appdir $app $global) 'current\\AstraGram.exe'",
        "Set-Content -LiteralPath (Join-Path $external 'scoop') -Value $exe -Encoding ascii"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Kindness-Kismet/AstraGram-Desktop/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Kindness-Kismet/AstraGram-Desktop/releases/download/v$version/AstraGram-v$version-win-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/Kindness-Kismet/AstraGram-Desktop/releases/download/v$version/AstraGram-v$version-win-arm64.zip"
            }
        }
    },
    "notes": [
        "AstraGram data is stored in the TelegramForcePortable directory under the Scoop persist folder.",
        "The built-in updater is disabled so Scoop and UniGetUI remain the update source."
    ]
}

{
    "version": "2026.09.05.5",
    "description": "Launches local players from Emby/Jellyfin/Plex, syncs playback progress to Floppy, and includes a lightweight configuration GUI.",
    "homepage": "https://github.com/nonlog/embyToLocalPlayer",
    "icon": "https://raw.githubusercontent.com/nonlog/scoop-www/master/icons/embyToLocalPlayer.svg",
    "license": "Unknown",
    "url": "https://github.com/nonlog/embyToLocalPlayer/releases/download/2026.09.05.5/embyToLocalPlayer.zip",
    "hash": "4fd4763ac4ce6d9ee7bc376d9e11214b6cdc06dcbcefbd9327237b33ca0c4a1b",
    "pre_install": [
        "Set-Content \"$dir\\embyToLocalPlayer_d.bat\" 'echo 1 | %~dp0\\embyToLocalPlayer_debug.bat' -Encoding ASCII",
        "Set-Content \"$dir\\embyToLocalPlayer_config.bat\" '@echo off' -Encoding ASCII",
        "Add-Content \"$dir\\embyToLocalPlayer_config.bat\" 'start \"\" pythonw \"%~dp0config_gui.py\" %*' -Encoding ASCII",
        "if (!(Test-Path \"$dir\\trakt_token.json\")) { New-Item \"$dir\\trakt_token.json\" -ItemType File | Out-Null }"
    ],
    "bin": [
        [
            "embyToLocalPlayer_debug.bat",
            "embyToLocalPlayer"
        ],
        [
            "embyToLocalPlayer_d.bat",
            "embyToLocalPlayer_d"
        ],
        [
            "embyToLocalPlayer_config.bat",
            "embyToLocalPlayer_config"
        ]
    ],
    "persist": [
        "embyToLocalPlayer_config.ini",
        "trakt_token.json"
    ],
    "checkver": {
        "github": "https://github.com/nonlog/embyToLocalPlayer",
        "regex": "/releases/tag/([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/nonlog/embyToLocalPlayer/releases/download/$version/embyToLocalPlayer.zip"
    }
}

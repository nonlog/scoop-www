{
    "version": "2026.07.18",
    "description": "Launches local external players from Emby, Jellyfin, and Plex and syncs playback progress.",
    "homepage": "https://github.com/kjtsune/embyToLocalPlayer",
    "license": "Unknown",
    "url": "https://github.com/kjtsune/embyToLocalPlayer/releases/download/2026.07.18/embyToLocalPlayer.zip",
    "hash": "f3e38c2e1593c13f7582b9153a67f88fdc7211bd67e8077841a414d2ff8b0154",
    "pre_install": [
        "Set-Content \"$dir\\embyToLocalPlayer_d.bat\" 'echo 1 | %~dp0\\embyToLocalPlayer_debug.bat' -Encoding ASCII",
        "if (!(Test-Path \"$dir\\trakt_token.json\")) { New-Item \"$dir\\trakt_token.json\" -ItemType File | Out-Null }"
    ],
    "bin": [
        [
            "embyToLocalPlayer_debug.bat",
            "embyToLocalPlayer"
        ],
        [
            "embyToLocalPlayer_d.bat",
            "embyToLocalPlayer_d"
        ]
    ],
    "persist": [
        "embyToLocalPlayer_config.ini",
        "trakt_token.json"
    ],
    "checkver": {
        "github": "https://github.com/kjtsune/embyToLocalPlayer",
        "regex": "/releases/tag/([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/kjtsune/embyToLocalPlayer/releases/download/$version/embyToLocalPlayer.zip"
    }
}

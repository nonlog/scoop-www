{
    "version": "0.1.21",
    "description": "Battery-first phone/Windows companion for clipboard, screenshots, notifications, and file handoff.",
    "homepage": "https://github.com/nonlog/Conduit",
    "icon": "https://raw.githubusercontent.com/nonlog/Conduit/v0.1.20/windows/conduit-daemon/assets/conduit-icon.ico",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/nonlog/Conduit/releases/download/v0.1.21/Conduit-0.1.21-windows-x64.zip",
            "hash": "25fe54ee4c8dcba2c7fe6c4029efe06387db71e4dee9eb6a00880aa376cf0ceb"
        }
    },
    "bin": "conduit-rune.exe",
    "persist": "data",
    "post_install": "& \"$dir\\tools\\install-windows.ps1\" -SourceDir \"$dir\" -InstallDir \"$dir\"",
    "pre_uninstall": "if ($cmd -eq 'uninstall') { & \"$dir\\tools\\uninstall-windows.ps1\" }",
    "checkver": {
        "url": "https://github.com/nonlog/Conduit/releases/latest",
        "regex": "/releases/tag/(?:v|V)?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nonlog/Conduit/releases/download/v$version/Conduit-$version-windows-x64.zip"
            }
        }
    },
    "notes": [
        "Rune is the native Windows desktop; the Share Target is a separate Rust host with a signed MSIX identity package.",
        "Scoop persists pairing identity, history, Relay and tray settings under persist/conduit/data across updates.",
        "The installer preserves existing Start-at-sign-in and Explorer Send with Conduit choices when migrating or updating."
    ]
}

{
    "version": "0.1.8",
    "description": "Battery-first phone/Windows companion for clipboard, screenshots, notifications, and file handoff.",
    "homepage": "https://github.com/nonlog/Conduit",
    "icon": "https://raw.githubusercontent.com/nonlog/Conduit/v0.1.0/windows/conduit-daemon/assets/conduit-icon.ico",
    "license": "Unknown",
    "architecture": {
        "64bit": {
            "url": "https://github.com/nonlog/Conduit/releases/download/v0.1.8/Conduit-0.1.8-windows-x64.zip",
            "hash": "7c21a5def822343b46ac37a8f47f06511f9ff4424b1fd182eebf39af44946d7f"
        }
    },
    "bin": "Conduit.exe",
    "post_install": "& \"$dir\\tools\\install-windows.ps1\" -SourceDir \"$dir\" -InstallDir \"$dir\"",
    "pre_uninstall": "if ($cmd -eq 'uninstall') { & \"$dir\\tools\\uninstall-windows.ps1\" }",
    "checkver": {
        "url": "https://github.com/nonlog/Conduit/releases/latest",
        "regex": "/releases/tag/(?:v|V)?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nonlog/Conduit/releases/download/v$version/Conduit-$version-windows-x64.zip"
            }
        }
    },
    "notes": [
        "Conduit.exe is the user-facing control surface; conduit-daemon.exe runs silently in the background.",
        "Pairing identity, history, Relay preferences, and tray preference live under %LOCALAPPDATA%\\Conduit and survive Scoop updates/uninstall.",
        "The installer preserves existing Start-at-sign-in and Explorer Send with Conduit choices when migrating or updating."
    ]
}

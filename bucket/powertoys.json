{
    "version": "0.101.2522.0",
    "description": "A set of utilities for power users to tune and streamline their Windows experience for greater productivity.",
    "homepage": "https://github.com/microsoft/PowerToys",
    "license": "MIT",
    "icon": "https://raw.githubusercontent.com/microsoft/PowerToys/main/doc/images/icons/PowerToys%20icon/PNG/PowerToysAppList.targetsize-256.png",
    "notes": [
        "Command Palette is a Windows MSIX package and therefore lives in WindowsApps, not under Scoop.",
        "This manifest upgrades Command Palette without unregistering it, so its favorites are retained.",
        "To add PowerToys context-menu integrations, run: Invoke-Expression -Command \"& `\"$dir\\install-context.ps1`\"\""
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/microsoft/PowerToys/releases/download/v0.101.2522.0/PowerToysUserSetup-0.101.2522.0-x64.exe",
            "hash": "9ceeedf9345f740f760178d8aa2c81c3326c343411e256e65a2fa77066883c"
        },
        "arm64": {
            "url": "https://github.com/microsoft/PowerToys/releases/download/v0.101.2522.0/PowerToysUserSetup-0.101.2522.0-arm64.exe",
            "hash": "c24babe0a9ce490662628809d70dce0192151ff6807af7912b1263c7a12128b1"
        }
    },
    "pre_install": "& \"$bucketsdir\\$bucket\\scripts\\powertoys\\command-palette-state.ps1\" -Phase Backup -PersistDir \"$persist_dir\"",
    "installer": {
        "script": [
            "$stagingDir = Join-Path $dir '.tmp'",
            "if (Test-Path -LiteralPath $stagingDir) {",
            "    $recoveryRoot = Join-Path $persist_dir 'recovery'",
            "    New-Item -ItemType Directory -Path $recoveryRoot -Force | Out-Null",
            "    $recoveryDir = Join-Path $recoveryRoot ('staging-' + (Get-Date -Format 'yyyyMMdd-HHmmss'))",
            "    Move-Item -LiteralPath $stagingDir -Destination $recoveryDir -ErrorAction Stop",
            "}",
            "Expand-DarkArchive \"$dir\\$fname\" $stagingDir",
            "$msi = @(Get-ChildItem -LiteralPath \"$stagingDir\\AttachedContainer\" -Filter 'PowerToysUserSetup*.msi' -File)",
            "if ($msi.Count -ne 1) { throw 'Expected exactly one embedded PowerToys MSI.' }",
            "Rename-Item -LiteralPath $msi[0].FullName -NewName 'PowerToysSetup.msi' -Force",
            "$ver = ([xml](Get-Content -Raw \"$stagingDir\\UX\\manifest.xml\" -Encoding utf8)).BurnManifest.EngineVersion",
            "if (($null -ne $ver) -and ($ver -like '5.*')) {",
            "    Expand-MsiArchive \"$stagingDir\\AttachedContainer\\PowerToysSetup.msi\" \"$dir\" -ExtractDir 'LocalApp\\PowerToys'",
            "} else {",
            "    Expand-MsiArchive \"$stagingDir\\AttachedContainer\\PowerToysSetup.msi\" \"$dir\" -ExtractDir 'PowerToys'",
            "}",
            "Remove-Item -LiteralPath $stagingDir, \"$dir\\$fname\" -Force -Recurse",
            "Get-Content \"$dir\\WinUI3Apps\\hardlinks.txt\" -ErrorAction Ignore | ForEach-Object {",
            "    Copy-Item \"$dir\\$_\" \"$dir\\WinUI3Apps\\$_\" -Force",
            "}"
        ]
    },
    "post_install": [
        "'install-context', 'uninstall-context', 'command-palette-state' | ForEach-Object {",
        "    if (Test-Path \"$bucketsdir\\$bucket\\scripts\\$app\\$_.ps1\") {",
        "        $content = Get-Content \"$bucketsdir\\$bucket\\scripts\\$app\\$_.ps1\"",
        "        $content = $content.Replace('{{scoop_dir}}', $original_dir)",
        "        if ($global) {",
        "            $content = $content.Replace('{{install_scope}}', 'perMachine')",
        "            $content = $content.Replace('{{registry_scope}}', 'HKLM')",
        "        } else {",
        "            $content = $content.Replace('{{install_scope}}', 'perUser')",
        "            $content = $content.Replace('{{registry_scope}}', 'HKCU')",
        "        }",
        "        $content | Set-Content -Path \"$dir\\$_.ps1\"",
        "    }",
        "}",
        "& \"$dir\\command-palette-state.ps1\" -Phase Restore -PersistDir \"$persist_dir\" -PackageDir \"$dir\"",
        "$regpath = 'HKCU:\\Software\\Classes\\powertoys'",
        "if ($global) { $regpath = $regpath.Replace('HKCU', 'HKLM') }",
        "if (Test-Path -LiteralPath $regpath) {",
        "    Remove-Item -LiteralPath $regpath -Recurse -Force | Out-Null",
        "    Invoke-Expression -Command \"& `\"$dir\\install-context.ps1`\"\"",
        "}"
    ],
    "uninstaller": {
        "script": [
            "if (Test-Path -LiteralPath \"$dir\\command-palette-state.ps1\") { & \"$dir\\command-palette-state.ps1\" -Phase Backup -PersistDir \"$persist_dir\" }",
            "$regpath = 'HKCU:\\Software\\Classes\\powertoys'",
            "if ($global) { $regpath = $regpath.Replace('HKCU', 'HKLM') }",
            "if (Test-Path -LiteralPath $regpath) {",
            "    Invoke-Expression -Command \"& `\"$dir\\uninstall-context.ps1`\"\"",
            "    if ($cmd -ne 'uninstall') { New-Item -Path $regpath -Force | Out-Null }",
            "}"
        ]
    },
    "shortcuts": [
        [
            "PowerToys.exe",
            "PowerToys"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/microsoft/PowerToys/releases",
        "jsonpath": "$[0].assets[*].browser_download_url",
        "regex": "/releases/download/(?<tag>[\\w.]+)/PowerToysUserSetup-([\\d.]+)-x64\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/microsoft/PowerToys/releases/download/v$version/PowerToysUserSetup-$version-x64.exe"
            },
            "arm64": {
                "url": "https://github.com/microsoft/PowerToys/releases/download/v$version/PowerToysUserSetup-$version-arm64.exe"
            }
        },
        "hash": {
            "url": "https://github.com/microsoft/PowerToys/releases/tag/v$version",
            "regex": "(?sm)$basename.*?>$sha256<"
        }
    }
}

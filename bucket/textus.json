    "pre_install": [
        "$pluginDir = Join-Path $dir '$PLUGINSDIR'",
        "if (Test-Path -LiteralPath $pluginDir) { Remove-Item -LiteralPath $pluginDir -Recurse -Force }",
        "Remove-Item -LiteralPath (Join-Path $dir 'uninstall.exe') -Force -ErrorAction SilentlyContinue"
    ],
    "bin": "textus.exe",
    "shortcuts": [
        [
            "textus.exe",
            "Textus"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/CatVinci-Studio/Textus/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CatVinci-Studio/Textus/releases/download/v$version/Textus_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/CatVinci-Studio/Textus/releases/download/v$version/Textus_$version_arm64-setup.exe#/dl.7z"
            }
        }
    },
    "notes": "Update this installation through Scoop."

{
    "version": "1.3.10",
    "description": "Next-generation Markdown editor with an AI writing assistant.",
    "homepage": "https://github.com/CatVinci-Studio/Textus",
    "icon": "https://raw.githubusercontent.com/nonlog/scoop-www/master/icons/textus.ico",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/CatVinci-Studio/Textus/releases/download/v1.3.10/Textus_1.3.10_x64-setup.exe#/dl.7z",
            "hash": "afa365009bbbf0fe024c15bd0271b78fd87046060dc6bad2504d5f7db08a79f3"
        },
        "arm64": {
            "url": "https://github.com/CatVinci-Studio/Textus/releases/download/v1.3.10/Textus_1.3.10_arm64-setup.exe#/dl.7z",
            "hash": "dfdffb655dc8e6cfd72476c3a5fb191054f1dcb58b1281cef354752db2c8815d"
        }
    },
    "pre_install": [
        "$pluginDir = Join-Path $dir '$PLUGINSDIR'",
        "if (Test-Path -LiteralPath $pluginDir) { Remove-Item -LiteralPath $pluginDir -Recurse -Force }",
        "Remove-Item -LiteralPath (Join-Path $dir 'uninstall.exe') -Force -ErrorAction SilentlyContinue"
    ],
    "bin": "textus.exe",
    "shortcuts": [
        [
            "textus.exe",
            "Textus"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/CatVinci-Studio/Textus/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/CatVinci-Studio/Textus/releases/download/v$version/Textus_$version_x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/CatVinci-Studio/Textus/releases/download/v$version/Textus_$version_arm64-setup.exe#/dl.7z"
            }
        }
    },
    "notes": "Update this installation through Scoop."
}

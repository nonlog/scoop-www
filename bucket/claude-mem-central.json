{
    "version": "15.15.1",
    "description": "Manually update the central Worker when needed and synchronize this computer's Claude/Codex/npm clients.",
    "homepage": "https://github.com/nonlog/central-memory-bridges",
    "license": "MIT",
    "url": [
        "https://registry.npmjs.org/claude-mem/15.15.1#/release.json",
        "https://raw.githubusercontent.com/nonlog/central-memory-bridges/c92522701b176a379069cb57619bf6a5be8a6c96/deploy/windows/install-central-client.ps1",
        "https://raw.githubusercontent.com/nonlog/central-memory-bridges/c92522701b176a379069cb57619bf6a5be8a6c96/deploy/windows/sync-claude-mem-central.ps1",
        "https://raw.githubusercontent.com/nonlog/central-memory-bridges/c92522701b176a379069cb57619bf6a5be8a6c96/deploy/windows/claude-mem-remote-worker-guard.cjs",
        "https://raw.githubusercontent.com/nonlog/central-memory-bridges/c92522701b176a379069cb57619bf6a5be8a6c96/deploy/windows/claude-mem-ensure-launcher-path.cjs",
        "https://raw.githubusercontent.com/nonlog/central-memory-bridges/c92522701b176a379069cb57619bf6a5be8a6c96/deploy/windows/central-client-compatibility.json"
    ],
    "hash": [
        "78883dbc999e5df4bee935086b2d275c98f11444deec0d128bcfc3471c538542",
        "f85036bdf08cbad795280cd2f5276d532747016f2d8dfea88af0d0fdbdf45917",
        "000c2a0e08b57f77fd44068f78ff52412c6c66d760339b8c2cee4b76274dabe0",
        "87c5f592b1eeba01bd74796e328c91d3931cecf53ee234fd9b18e8aba5318adf",
        "27b10677c3f7999b093497309d73fb4edd0c5ed4b95d4b7addd55520e075cc04",
        "824ff98cab3215373fa60c643d859e178e225724760e4254faa8f8448dd5ff34"
    ],
    "pre_install": [
        "$target = [string]$Manifest.version",
        "if ($target -notmatch '^\\d+\\.\\d+\\.\\d+$') { throw 'Invalid official Claude-mem version in Scoop manifest' }",
        "$installer = Join-Path $dir 'install-central-client.ps1'",
        "try {",
        "  & pwsh -NoLogo -NoProfile -File $installer -UpdateCentral -TargetVersion $target",
        "  if ($LASTEXITCODE -ne 0) { throw \"Claude-mem synchronization failed ($LASTEXITCODE). Retry local sync after correcting the reported problem.\" }",
        "} catch {",
        "  $failure = $_",
        "  $scoopScript = (Get-Command scoop.ps1 -ErrorAction SilentlyContinue).Source",
        "  if ($scoopScript) { & pwsh -NoLogo -NoProfile -File $scoopScript reset claude-mem-central 2>$null | Out-Null }",
        "  throw $failure",
        "}"
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/claude-mem/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": [
            "https://registry.npmjs.org/claude-mem/$version#/release.json",
            "https://raw.githubusercontent.com/nonlog/central-memory-bridges/c92522701b176a379069cb57619bf6a5be8a6c96/deploy/windows/install-central-client.ps1",
            "https://raw.githubusercontent.com/nonlog/central-memory-bridges/c92522701b176a379069cb57619bf6a5be8a6c96/deploy/windows/sync-claude-mem-central.ps1",
            "https://raw.githubusercontent.com/nonlog/central-memory-bridges/c92522701b176a379069cb57619bf6a5be8a6c96/deploy/windows/claude-mem-remote-worker-guard.cjs",
            "https://raw.githubusercontent.com/nonlog/central-memory-bridges/c92522701b176a379069cb57619bf6a5be8a6c96/deploy/windows/claude-mem-ensure-launcher-path.cjs",
            "https://raw.githubusercontent.com/nonlog/central-memory-bridges/c92522701b176a379069cb57619bf6a5be8a6c96/deploy/windows/central-client-compatibility.json"
        ]
    },
    "notes": [
        "This manual action upgrades the central Worker only when necessary, then synchronizes this computer.",
        "Other computers follow the healthy central version when they are updated; stale requests never downgrade the server.",
        "Use sync-claude-mem-central.ps1 -SyncLocal to retry only this computer. Restart Claude/Codex after changing plugins.",
        "The original npm/claude-mem row stays ignored in UniGetUI. No scheduled Worker upgrade or background client updater is enabled."
    ]
}

{
    "version": "1.3.1",
    "description": "Portable Windows taskbar media controller with playback controls, lyrics, and audio device switching.",
    "homepage": "https://github.com/Fervent-Tempo/AF-Media-Bar",
    "license": "MIT",
    "icon": "https://raw.githubusercontent.com/nonlog/scoop-www/master/icons/af-media-bar.ico",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Fervent-Tempo/AF-Media-Bar/releases/download/v1.3.1/AFMediaBar-v1.3.1-win-x64.zip",
            "hash": "d06129cf550d0bdffd546c6f1e5f6a15d06e3363dc575ce90d1047bbfa35463e"
        }
    },
    "bin": [
        [
            "AFMediaBar.exe",
            "af-media-bar"
        ]
    ],
    "shortcuts": [
        [
            "AFMediaBar.exe",
            "AF Media Bar"
        ]
    ],
    "post_install": [
        "$app_data = Join-Path $env:LOCALAPPDATA 'AFMediaBar'",
        "$persist_data = Join-Path $persist_dir 'data'",
        "New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
        "if (Test-Path -LiteralPath $app_data) {",
        "    $existing = Get-Item -LiteralPath $app_data -Force",
        "    if ($existing.LinkType) {",
        "        $target = $existing.Target | Select-Object -First 1",
        "        if (-not $target -or ([IO.Path]::GetFullPath($target).TrimEnd('\\') -ne [IO.Path]::GetFullPath($persist_data).TrimEnd('\\'))) { Write-Warning 'Existing AF Media Bar data link was not changed.' }",
        "    } else {",
        "        Copy-Item -Path (Join-Path $app_data '*') -Destination $persist_data -Recurse -Force -ErrorAction Stop",
        "        Remove-Item -LiteralPath $app_data -Recurse -Force -ErrorAction Stop",
        "    }",
        "}",
        "if (!(Test-Path -LiteralPath $persist_data)) { New-Item -ItemType Directory -Path $persist_data -Force | Out-Null }",
        "if (!(Test-Path -LiteralPath $app_data)) { New-DirectoryJunction $app_data $persist_data | Out-Null }"
    ],
    "post_uninstall": [
        "$app_data = Join-Path $env:LOCALAPPDATA 'AFMediaBar'",
        "$persist_data = Join-Path $persist_dir 'data'",
        "if (Test-Path -LiteralPath $app_data) {",
        "    $existing = Get-Item -LiteralPath $app_data -Force",
        "    $target = $existing.Target | Select-Object -First 1",
        "    if ($existing.LinkType -eq 'Junction' -and $target -and ([IO.Path]::GetFullPath($target).TrimEnd('\\') -eq [IO.Path]::GetFullPath($persist_data).TrimEnd('\\'))) { Remove-Item -LiteralPath $app_data -Force }",
        "}"
    ],
    "checkver": {
        "url": "https://github.com/Fervent-Tempo/AF-Media-Bar/releases/latest",
        "regex": "/releases/tag/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Fervent-Tempo/AF-Media-Bar/releases/download/v$version/AFMediaBar-v$version-win-x64.zip",
                "hash": {
                    "url": "https://github.com/Fervent-Tempo/AF-Media-Bar/releases/download/v$version/SHA256SUMS.txt",
                    "regex": "$sha256\\s+AFMediaBar-v$version-win-x64\\.zip"
                }
            }
        }
    },
    "notes": [
        "AF Media Bar settings are redirected from %LOCALAPPDATA%\\AFMediaBar to the Scoop persist directory.",
        "The portable build requires Microsoft Edge WebView2 Runtime."
    ]
}
